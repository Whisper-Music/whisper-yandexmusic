{
  "name": "yandex-desktop",
  "private": true,
  "version": "1.2.5",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "build": "tauri build --config src-tauri/tauri.local.conf.json",
    "android:apk": "tauri android build --debug --apk --target aarch64",
    "android:release": "tauri android build --apk --target aarch64",
    "version": "node scripts/set-version.mjs",
    "test:web": "playwright test -c tests/web/playwright.config.mjs",
    "test:web:update": "playwright test -c tests/web/playwright.config.mjs --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "@tauri-apps/plugin-http": "^2.8.0"
  }
}
